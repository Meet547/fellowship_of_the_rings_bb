# KHOJ frontend public configuration
# These are public endpoint/config values, not AWS credentials.

NEXT_PUBLIC_AWS_REGION=ap-southeast-2
NEXT_PUBLIC_API_BASE_URL=https://9zyg11hh53.execute-api.ap-southeast-2.amazonaws.com/dev

# Email/password authentication already uses the deployed Cognito user pool
# configured in src/lib/amplify.ts.
#
# Optional: only set these if social sign-in is configured for the deployment.
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=
NEXT_PUBLIC_COGNITO_SOCIAL_PROVIDERS=
